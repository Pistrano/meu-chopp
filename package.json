{
  "name": "barrilfacil",
  "version": "2.0.0",
  "description": "BarrilFacil - controle de barris de chopp (servidor + aplicativo)",
  "main": "src/main/main.js",
  "scripts": {
    "server": "node --use-system-ca src/server/server.js",
    "test": "node --test --test-concurrency=1",
    "start": "electron .",
    "dist": "electron-builder",
    "dist:publicar": "electron-builder --publish always"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^18.0.8",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "br.com.barrilfacil.app",
    "productName": "BarrilFacil",
    "files": [
      "src/main/**/*",
      "src/renderer/css/**/*",
      "src/renderer/vendor/bootstrap-lite.css",
      "src/renderer/assets/**/*",
      "build/icon.ico",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Pistrano",
        "repo": "meu-chopp"
      }
    ]
  },
  "engines": {
    "node": ">=18"
  }
}
