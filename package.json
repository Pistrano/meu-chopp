{
  "name": "meu-chopp",
  "version": "2.0.0",
  "description": "MeuChopp - controle de barris de chopp dos quiosques (servidor + aplicativo)",
  "main": "src/main/main.js",
  "scripts": {
    "server": "node --use-system-ca src/server/server.js",
    "test": "node --test",
    "start": "electron .",
    "dist": "electron-builder"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^18.0.8",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "br.com.meuchopp.app",
    "productName": "MeuChopp",
    "files": [
      "src/main/**/*",
      "src/renderer/css/**/*",
      "src/renderer/vendor/bootstrap-lite.css",
      "src/renderer/assets/**/*",
      "build/icon.ico",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    }
  },
  "engines": {
    "node": ">=18"
  }
}
