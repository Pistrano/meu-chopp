# ==========================================================
# BarrilFacil — modelo do arquivo .env do servidor
# Copie para ".env" (na raiz do projeto) e troque os valores de exemplo.
# O .env nunca vai para o repositório: ele guarda a chave secreta do banco.
#
# Só as duas do Supabase são obrigatórias. As outras têm um padrão e ficam comentadas:
# tire o # da frente para usar. No servidor Linux, PORT, HOST e TRUST_PROXY já vêm do
# serviço (deploy/barrilfacil.service); não as ative aqui, porque o .env passaria por cima.
# (BARRILFACIL_ENV, variável do sistema e não deste arquivo, aponta para um .env em outro lugar.)
# ==========================================================

# ---------- Banco (Supabase) — obrigatórias ----------
# Endereço do projeto no Supabase, sem /rest/v1 (Project Settings > Data API)
SUPABASE_URL=https://exemplo-do-projeto.supabase.co
# Chave secreta do projeto (Project Settings > API Keys > Secret keys). Só o servidor usa; nunca mande em chat.
SUPABASE_SECRET_KEY=sb_secret_troque-pela-chave-do-seu-projeto

# ---------- Servidor ----------
# Porta em que o servidor escuta (padrão 3000)
# PORT=3000
# Endereço de escuta (padrão 0.0.0.0, aceita a rede; 127.0.0.1 só a própria máquina, usado atrás do Caddy)
# HOST=0.0.0.0
# 1 quando o servidor fica atrás do Caddy/Nginx com HTTPS (passa a confiar nos cabeçalhos X-Forwarded-*)
# TRUST_PROXY=1

# ---------- Operação ----------
# Fuso da operação, usado nas datas e horas mostradas e no "hoje" (padrão America/Cuiaba)
# APP_TZ=America/Cuiaba
# Quem entrega os barris; aparece como origem das entradas no histórico (padrão "Fornecedor")
# NOME_FORNECEDOR=Nome da fábrica

# ---------- Ambiente ----------
# beta = ambiente de testes: faixa amarela "AMBIENTE DE TESTES" em todas as telas e "[TESTE]" no título da aba.
# Nunca use no servidor das lojas.
# APP_ENV=beta
