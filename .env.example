# Copie este arquivo para .env (na mesma pasta) e preencha os valores.
# O .env nunca vai para o repositório: ele guarda a chave secreta do banco.

# Endereço do projeto no Supabase (Project Settings > Data API), sem /rest/v1 no fim.
SUPABASE_URL=

# Chave secreta do Supabase (Project Settings > API Keys > Secret keys, começa com sb_secret_).
# Só o servidor usa: nunca coloque em tela, chat ou código.
SUPABASE_SECRET_KEY=

# Fuso horário da operação, usado para as datas "de hoje" (validade) e para mostrar data e hora.
APP_TZ=America/Cuiaba

# Nome de quem entrega os barris, mostrado no histórico como origem das entradas. Vazio = "Fornecedor".
NOME_FORNECEDOR=
